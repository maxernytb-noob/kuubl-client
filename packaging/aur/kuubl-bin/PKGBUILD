# Maintainer: maxem <maxernytb@gmail.com>
# Prebuilt Kuubl Client: the same Arch package the website offers, repackaged for the AUR.
# Updated by packaging/aur/update-aur.sh after every release.
pkgname=kuubl-bin
pkgver=1.0.2
pkgrel=1
pkgdesc="Minecraft launcher for playing and recording - Modrinth and CurseForge mods, clips, friends"
arch=('x86_64')
url="https://ertenix.net/kuubl/"
license=('MIT')
provides=('kuubl-client')
conflicts=('kuubl-client' 'justice-client')
depends=(
  'webkit2gtk-4.1' 'gtk3' 'hicolor-icon-theme'
  'libglvnd' 'libx11' 'libxcursor' 'libxrandr' 'libxi' 'alsa-lib'
  'gst-plugins-good' 'gst-libav'
)
optdepends=(
  'xorg-xrandr: older Minecraft versions (1.12 and below)'
  'libpulse: sound through PulseAudio/PipeWire'
  'discord: "Playing Kuubl Client" status'
  'obs-studio: automatic recording when the game starts'
  'gpu-screen-recorder: Kuubl Clips (replay buffer, AUR)'
  'ffmpeg: Kuubl Clips thumbnails and trimming'
  'libnotify: Kuubl Clips notifications'
  'polkit: in-app updates for non-AUR installs'
)
options=('!strip' '!debug')
source=("https://ertenix.net/kuubl/kuubl-client-${pkgver}-1-x86_64.pkg.tar.zst")
noextract=("kuubl-client-${pkgver}-1-x86_64.pkg.tar.zst")
sha256sums=('SKIP')

package() {
  bsdtar -xf "$srcdir/kuubl-client-${pkgver}-1-x86_64.pkg.tar.zst" -C "$pkgdir" --exclude '.PKGINFO' --exclude '.MTREE' --exclude '.BUILDINFO' --exclude '.INSTALL'
}
